      project_directory=""
      project_type="Executable"
      debug_target_connection="GDB Server"
      gdb_server_type="Custom"
      gdb_server_reset_command="halt"
      gdb_server_autostart_server="No"
      gdb_server_port="3334"
      gdb_server_command_line="D:/v113test/sdk_env_v1.13.0/tools/openocd/openocd.exe -f $(ProjectDir)/../../../../../../hpm_sdk/boards/openocd/probes/ft2232.cfg -f $(ProjectDir)/../../../../../../hpm_sdk/boards/openocd/soc/hpm6e80-dual-core.cfg -f D:/v113test/sdk_env_v1.13.0/user_template/boards/hpm6e8ydemo/hpm6e8ydemo.cfg"
      target_device_name="HPM6E80xVMx_CPU1"
      linker_output_format="bin"
      post_build_command="D:/v113test/sdk_env_v1.13.0/tools/python3/python3.exe ../../../../../../hpm_sdk/scripts/bin2c.py $(OutDir)/demo.bin sec_core_img > D:/v113test/sdk_env_v1.13.0/user_template/projects/dual_threadx/core1/../core0/src/sec_core_img.c &amp;&amp; &quot;$(OBJDUMP)&quot; -S -d &quot;$(OutDir)/demo$(EXE)&quot; &gt; &quot;$(OutDir)/demo.asm&quot;"
      heap_size="0x4000"
      stack_size="0x4000"
      RISCV_TOOLCHAIN_VARIANT="Standard"
      rv_abi="ilp32"
      rv_architecture="rv32imac"
      c_additional_options="-Wall;-Wundef;-Wno-format;-fomit-frame-pointer;-fno-builtin;-ffunction-sections;-fdata-sections"
      rv_arch_ext=""
      rv_arch_zicsr="Yes"
      rv_arch_zifencei="Yes"
      rv_arch_zba="Yes"
      rv_arch_zbb="Yes"
      rv_arch_zbc="Yes"
      rv_arch_zbs="Yes"
      rv_debug_extensions="None"
      rv_toolchain_prefix=""
      gcc_cplusplus_language_standard="c++11"
      libcxx="Yes"
      build_output_file_name="$(OutDir)/demo$(EXE)"
      linker_printf_fp_enabled="Float"
      linker_printf_fmt_level="int"
      linker_printf_wchar_enabled="No"
      linker_printf_width_precision_supported="Yes"
      linker_scanf_fp_enabled="No"
      linker_scanf_fmt_level="int"
      linker_scanf_character_group_matching_enabled="No"
      gcc_enable_all_warnings="Yes"
